#!/bin/bash
# Based on shunt from spotify/portal-ai-plugins (Apache-2.0), rewritten with changes. See NOTICE.
# PreToolUse hook for Read. Denies a full read of a text file longer than
# SHUNT_MIN_LINES and points Claude at the bulk-reader skill instead.
# Reads with an offset or limit pass, since Claude already knows which
# section it needs.

# shellcheck source=plugins/langsmith-shunt/scripts/lib/hook.sh
. "$(cd "$(dirname "$0")/.." && pwd)/scripts/lib/hook.sh"

input=$(cat)
shunt_hooks_enabled || exit 0

file_path=$(jq -r '.tool_input.file_path // empty' <<<"$input")
offset=$(jq -r '.tool_input.offset // empty' <<<"$input")
limit=$(jq -r '.tool_input.limit // empty' <<<"$input")
cwd=$(jq -r '.cwd // empty' <<<"$input")

if [ -n "$offset" ] || [ -n "$limit" ]; then
  exit 0
fi

path=$(shunt_resolve_path "$file_path" "$cwd") || exit 0
shunt_is_text "$path" || exit 0

lines=$(shunt_line_count "$path")
[ "${lines:-0}" -gt "$SHUNT_MIN_LINES" ] || exit 0

shunt_deny "$file_path is $lines lines, and full reads of files over $SHUNT_MIN_LINES lines are blocked. To answer a question about it, run this instead of reading it in parts with Read, grep, or sed: $(shunt_bulk_read_command "$file_path") It returns only the answer, and --paths takes several files at once. Only when you need to edit the file, Read the lines you will change with offset and limit."

#!/usr/bin/env python3
"""Report what langsmith-shunt delegations saved, measured from LangSmith runs.

Reads the delegation runs (tag "langsmith-shunt") from the tracing project.
When the langsmith-tracing plugin writes to the same project, it also reads
the Claude model runs of the same sessions, matched on metadata thread_id,
and estimates the input tokens the delegations kept out of those calls.

Usage: savings-report [--days 7] [--current | --session ID] [--project NAME] [--json]

Standard library only, so it runs wherever python3 does.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections import defaultdict
from datetime import datetime, timedelta, timezone

TAG = "langsmith-shunt"


def env(*names: str, default: str = "") -> str:
    for name in names:
        value = os.environ.get(name)
        if value:
            return value
    return default


ENDPOINT = env("LANGSMITH_ENDPOINT", default="https://api.smith.langchain.com").rstrip("/")
API_KEY = env("SHUNT_LANGSMITH_API_KEY", "CC_LANGSMITH_API_KEY", "LANGSMITH_API_KEY")
PROJECT = env("SHUNT_LANGSMITH_PROJECT", "CC_LANGSMITH_PROJECT", "LANGSMITH_PROJECT", default="claude-code")


def request(method: str, path: str, body: dict | None = None, params: dict | None = None):
    url = f"{ENDPOINT}{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("x-api-key", API_KEY)
    req.add_header("content-type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:300]
        sys.exit(f"Error: {method} {path} returned HTTP {e.code}: {detail}")
    except urllib.error.URLError as e:
        sys.exit(f"Error: could not reach {ENDPOINT}: {e.reason}")


def project_id(name: str) -> str:
    projects = request("GET", "/sessions", params={"name": name, "limit": 1})
    if not projects:
        sys.exit(f"Error: no LangSmith project named '{name}'.")
    return projects[0]["id"]


def query_runs(body: dict) -> list[dict]:
    runs, body = [], {**body, "limit": 100}
    while True:
        page = request("POST", "/runs/query", body=body)
        runs.extend(page.get("runs", []))
        cursor = (page.get("cursors") or {}).get("next")
        if not cursor:
            return runs
        body["cursor"] = cursor


def tokens(run: dict) -> tuple[int, int]:
    usage = (run.get("outputs") or {}).get("usage_metadata") or {}
    return (
        int(run.get("prompt_tokens") or usage.get("input_tokens") or 0),
        int(run.get("completion_tokens") or usage.get("output_tokens") or 0),
    )


def metadata(run: dict) -> dict:
    return (run.get("extra") or {}).get("metadata") or {}


def thread_of(run: dict) -> str:
    return metadata(run).get("thread_id") or "(no session id)"


def is_main_agent(run: dict) -> bool:
    # langsmith-tracing labels runs root, subagent, middleware, or compaction.
    # A file read by the main agent would only have stayed in root calls.
    return metadata(run).get("ls_agent_type", "root") == "root"


def thread_clauses(thread: str) -> str:
    return f'eq(metadata_key, "thread_id"), eq(metadata_value, {json.dumps(thread)})'


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--days", type=float, default=7, help="look back this many days (default 7)")
    parser.add_argument("--session", help="one Claude Code session id")
    parser.add_argument("--current", action="store_true", help="this Claude Code session (CLAUDE_CODE_SESSION_ID)")
    parser.add_argument("--project", default=PROJECT, help=f"LangSmith project (default {PROJECT})")
    parser.add_argument("--json", action="store_true", help="print JSON instead of a table")
    args = parser.parse_args()

    if args.current:
        args.session = os.environ.get("CLAUDE_CODE_SESSION_ID") or sys.exit("Error: CLAUDE_CODE_SESSION_ID is not set.")
    if not API_KEY:
        sys.exit("Error: set SHUNT_LANGSMITH_API_KEY, CC_LANGSMITH_API_KEY, or LANGSMITH_API_KEY.")

    pid = project_id(args.project)
    since = (datetime.now(timezone.utc) - timedelta(days=args.days)).isoformat()

    delegation_filter = f'has(tags, "{TAG}")'
    if args.session:
        delegation_filter = f"and({delegation_filter}, {thread_clauses(args.session)})"
    delegations = query_runs({
        "session": [pid],
        "filter": delegation_filter,
        "start_time": since,
        "select": ["id", "name", "start_time", "prompt_tokens", "completion_tokens", "total_cost", "extra", "outputs"],
    })
    if not delegations:
        print(f"No langsmith-shunt runs in '{args.project}' in the last {args.days:g} days.")
        return

    by_thread: dict[str, list[dict]] = defaultdict(list)
    for run in delegations:
        by_thread[thread_of(run)].append(run)

    sessions = []
    for thread, runs in sorted(by_thread.items()):
        claude_runs = []
        if thread != "(no session id)":
            claude_runs = [
                r for r in query_runs({
                    "session": [pid],
                    "run_type": "llm",
                    "filter": f"and({thread_clauses(thread)})",
                    "start_time": since,
                    "select": ["id", "name", "start_time", "prompt_tokens", "completion_tokens", "extra", "outputs"],
                })
                if not str(r.get("name", "")).startswith("shunt:")
            ]
        main_starts = sorted(r["start_time"] for r in claude_runs if is_main_agent(r))

        s = {
            "session": thread,
            "bulk_reads": 0,
            "code_writes": 0,
            "worker_input_tokens": 0,
            "worker_output_tokens": 0,
            "worker_cost": 0.0,
            "context_tokens_avoided": 0,
            "input_tokens_avoided_est": 0,
            "code_tokens_written_by_worker": 0,
            "claude_calls": len(claude_runs),
            "claude_input_tokens": sum(tokens(r)[0] for r in claude_runs),
        }
        for run in runs:
            tin, tout = tokens(run)
            s["worker_input_tokens"] += tin
            s["worker_output_tokens"] += tout
            s["worker_cost"] += float(run.get("total_cost") or 0)
            if run.get("name") == "shunt:bulk-read":
                s["bulk_reads"] += 1
                avoided = max(tin - tout, 0)
                later_calls = sum(1 for t in main_starts if t > run["start_time"])
                s["context_tokens_avoided"] += avoided
                s["input_tokens_avoided_est"] += avoided * later_calls
            elif run.get("name") == "shunt:code-write":
                s["code_writes"] += 1
                s["code_tokens_written_by_worker"] += tout
        total = s["claude_input_tokens"] + s["input_tokens_avoided_est"]
        s["input_reduction_est"] = round(s["input_tokens_avoided_est"] / total, 4) if s["claude_calls"] and total else None
        sessions.append(s)

    if args.json:
        print(json.dumps({"project": args.project, "days": args.days, "sessions": sessions}, indent=2))
        return

    print(f"langsmith-shunt savings in '{args.project}', last {args.days:g} days\n")
    for s in sessions:
        print(f"Session {s['session']}")
        print(f"  Delegations                      {s['bulk_reads']} bulk-read, {s['code_writes']} code-write")
        print(f"  Worker tokens in / out           {s['worker_input_tokens']:,} / {s['worker_output_tokens']:,}")
        if s["worker_cost"]:
            print(f"  Worker cost (LangSmith)          ${s['worker_cost']:.4f}")
        print(f"  Context tokens avoided [1]       {s['context_tokens_avoided']:,}")
        print(f"  Code tokens written by worker    {s['code_tokens_written_by_worker']:,}")
        if s["claude_calls"]:
            print(f"  Claude calls / input tokens      {s['claude_calls']:,} / {s['claude_input_tokens']:,}")
            print(f"  Input tokens avoided, est. [2]   {s['input_tokens_avoided_est']:,}")
            print(f"  Input reduction, est. [3]        {s['input_reduction_est']:.1%}")
        else:
            print("  Claude calls                     none found (is langsmith-tracing writing to this project?)")
        print()

    print("[1] Sum over bulk-reads of worker input tokens minus worker output tokens: the file")
    print("    content that did not enter Claude's context, less the answer that did. The worker")
    print("    input also holds the instructions and question, so this is slightly high.")
    print("[2] [1] for each bulk-read, times the number of main-agent Claude calls after it.")
    print("    Assumes the file would have stayed in context for every later call. Compaction")
    print("    would shorten that; prompt caching makes re-read tokens cheaper than new ones.")
    print("[3] [2] / (Claude input tokens + [2]).")
    print("Token counts use the worker model's tokenizer, which matches Claude's only for Claude workers.")


if __name__ == "__main__":
    main()
